{
  "name": "accessibility-platform",
  "private": true,
  "version": "0.1.0",
  "description": "Arabic-first digital accessibility platform (widget, reader, scanner, dashboard)",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.22.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=@a11y/api --filter=@a11y/dashboard --filter=@a11y/widget --parallel",
    "dev:all": "turbo run dev --filter=@a11y/api --filter=@a11y/dashboard --filter=@a11y/widget --parallel",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "widget:build": "pnpm --filter @a11y/widget build",
    "widget:dev": "pnpm --filter @a11y/widget dev",
    "dashboard:dev": "pnpm --filter @a11y/dashboard dev",
    "api:dev": "pnpm --filter @a11y/api dev",
    "scanner:cli": "pnpm --filter @a11y/scanner cli"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "prisma",
      "@prisma/client",
      "@prisma/engines",
      "@node-rs/argon2"
    ]
  }
}
